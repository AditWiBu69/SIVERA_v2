# Salin file ini menjadi .env.local lalu isi nilainya.
# .env.local TIDAK ikut ke git (lihat .gitignore).

# --- WAJIB ---
# Kunci rahasia untuk menandatangani/mengenkripsi session & cookie Auth.js.
# Tanpa ini akan muncul error "[auth][error] MissingSecret".
# Cara generate (pilih salah satu, jalankan di terminal project ini):
#   npx auth secret          -> otomatis generate & tulis ke .env.local
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# --- OPSIONAL: hanya wajib diisi kalau mau memakai tombol login GitHub ---
GITHUB_AUTH_CLIENT_ID=
GITHUB_AUTH_CLIENT_SECRET=

# --- OPSIONAL: hanya wajib diisi kalau mau memakai tombol login Google ---
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
